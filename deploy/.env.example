# ===== Bắt buộc =====
# 2 domain đã trỏ DNS (bản ghi A) về máy chủ — Caddy tự cấp HTTPS
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Email nhận cảnh báo hết hạn chứng chỉ từ Let's Encrypt
ACME_EMAIL=admin@example.com
# Mật khẩu Postgres — chỉ chữ + số (nằm trong URL kết nối): openssl rand -hex 24
POSTGRES_PASSWORD=
# Ký access token: openssl rand -base64 32 — đổi là mọi người phải đăng nhập lại
JWT_SECRET=
# Email liên hệ hiện trên trang /privacy (App Store / Google Play yêu cầu)
CONTACT_EMAIL=

# ===== Phiên đăng nhập =====
JWT_TTL=1h
REFRESH_TTL=1440h

# ===== Không bắt buộc — để trống thì tính năng đó tắt (xem apps/laclingo/backend/.env.example) =====
# Lưu file (ảnh blog, audio luyện nghe, ảnh từ vựng): Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# AI gợi ý từ vựng / phân tích câu
AI_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model dùng (để trống = mặc định trong code)
VOCAB_SUGGEST_MODEL=
GEMINI_MODEL=
# Web push nhắc học: npx web-push generate-vapid-keys — cần đủ cả 3 biến
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Thông báo đẩy app iOS/Android: đặt file JSON vào deploy/secrets/ rồi trỏ tới /secrets/<tên file> (quyền đọc: xem README)
FCM_SERVICE_ACCOUNT_FILE=
# Thanh toán web
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mua trong app
APPLE_BUNDLE_ID=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_RTDN_TOKEN=
IAP_ALLOW_SANDBOX=true
