PORT=8080
DATABASE_URL=postgresql://laclingo_user:laclingo_password@localhost:5432/laclingo_db?sslmode=disable
APP_ENV=development
# Bắt buộc khi APP_ENV=production. Sinh bằng: openssl rand -base64 32
JWT_SECRET=
# Hạn access token (mặc định 24h), ví dụ: 24h, 30m
JWT_TTL=24h

# Cloudflare R2 (lưu audio luyện nghe) — tạo API Token ở Cloudflare dashboard
# → R2 → Manage R2 API Tokens → Create API Token (quyền Object Read & Write).
# Không cần bật "Public access" cho bucket — backend tự tạo presigned URL khi phát.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Web push nhắc học — để trống thì tính năng nhắc học tắt. Tạo cặp khoá:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT: mailto:... hoặc https://... để push service liên hệ khi có sự cố.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI cho nút "✨ Gợi ý tự động" khi admin thêm từ (nghĩa tiếng Việt, câu ví dụ,
# từ loại, trình độ, emoji). Không có key nào thì chỉ gợi ý phiên âm/audio từ Free Dictionary API.
# AI_PROVIDER: claude | gemini — để trống thì tự chọn theo key đang có (ưu tiên claude)
AI_PROVIDER=
# Claude API (trả phí theo lượng dùng) — model mặc định claude-opus-5-5; claude-haiku-5-5 rẻ hơn
ANTHROPIC_API_KEY=
VOCAB_SUGGEST_MODEL=
# Google Gemini API (có gói miễn phí, lấy key ở aistudio.google.com/apikey) — model mặc định gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=
