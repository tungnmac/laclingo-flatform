PORT=8080
DATABASE_URL=postgresql://laclingo_user:laclingo_password@localhost:5432/laclingo_db?sslmode=disable
APP_ENV=development
# Bắt buộc khi APP_ENV=production. Sinh bằng: openssl rand -base64 32
JWT_SECRET=
# Hạn access token (mặc định 24h), ví dụ: 24h, 30m
JWT_TTL=24h

# Cloudflare R2 (lưu audio luyện nghe) — tạo API Token ở Cloudflare dashboard
# → R2 → Manage R2 API Tokens → Create API Token (quyền Object Read & Write).
# Không cần bật "Public access" cho bucket — backend tự tạo presigned URL khi phát.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
