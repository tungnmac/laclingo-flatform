PORT=8080
DATABASE_URL=postgresql://laclingo_user:laclingo_password@localhost:5432/laclingo_db?sslmode=disable
APP_ENV=development
# Bắt buộc khi APP_ENV=production. Sinh bằng: openssl rand -base64 32
JWT_SECRET=
# Hạn access token (mặc định 1h) — hết hạn thì app tự làm mới bằng refresh token, ví dụ: 1h, 30m
JWT_TTL=1h
# Hạn refresh token (mặc định 1440h = 60 ngày, tính lại mỗi lần làm mới)
REFRESH_TTL=1440h
# IP / dải IP reverse proxy (nginx, load balancer) được tin header X-Forwarded-For, cách nhau dấu phẩy.
# Chạy sau proxy mà để trống thì mọi người dùng chung IP của proxy → giới hạn đăng nhập theo IP chặn nhầm cả hệ thống.
TRUSTED_PROXIES=

# Cloudflare R2 (lưu audio luyện nghe) — tạo API Token ở Cloudflare dashboard
# → R2 → Manage R2 API Tokens → Create API Token (quyền Object Read & Write).
# Không cần bật "Public access" cho bucket — backend tự tạo presigned URL khi phát.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Web push nhắc học — để trống thì tính năng nhắc học tắt. Tạo cặp khoá:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT: mailto:... hoặc https://... để push service liên hệ khi có sự cố.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Thông báo đẩy trên app iOS/Android (FCM): đường dẫn file JSON service account của project Firebase
# (Firebase Console → Project settings → Service accounts → Generate new private key). KHÔNG commit file này.
FCM_SERVICE_ACCOUNT_FILE=

# AI cho nút "✨ Gợi ý tự động" khi admin thêm từ (nghĩa tiếng Việt, câu ví dụ,
# từ loại, trình độ, emoji). Không có key nào thì chỉ gợi ý phiên âm/audio từ Free Dictionary API.
# AI_PROVIDER: claude | gemini — để trống thì tự chọn theo key đang có (ưu tiên claude)
AI_PROVIDER=
# Claude API (trả phí theo lượng dùng) — model mặc định claude-opus-5-5; claude-haiku-5-5 rẻ hơn
ANTHROPIC_API_KEY=
VOCAB_SUGGEST_MODEL=
# Google Gemini API (có gói miễn phí, lấy key ở aistudio.google.com/apikey) — model mặc định gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=

# Thanh toán (gói Pro, gems) — cổng nào để trống thì tắt.
# VNPay (VND): đăng ký sandbox tại https://sandbox.vnpayment.vn/devreg/ để lấy mã website + chuỗi bí mật.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Để trống = sandbox (https://sandbox.vnpayment.vn/paymentv2/vpcpay.html)
VNPAY_PAY_URL=
# Stripe (USD, thẻ quốc tế; gói tháng/năm tự gia hạn): secret key + signing secret của webhook
# (local: `stripe listen --forward-to localhost:8080/api/v1/billing/stripe/webhook` in ra whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Địa chỉ trang web (trang kết quả thanh toán) và API public (VNPay chuyển về / gọi IPN)
APP_WEB_URL=http://localhost:3000
APP_API_URL=http://localhost:8080/api/v1

# Mua trong app iOS/Android — để trống thì tắt store đó (xem apps/laclingo/mobile/README.md).
# Apple: Bundle ID app iOS. App Store Connect → App Information → App Store Server Notifications (V2):
#   <API public>/billing/iap/apple/notifications
APPLE_BUNDLE_ID=
# Google Play: applicationId app Android + file JSON service account được mời vào Play Console (quyền xem tài chính,
# quản lý đơn hàng). RTDN: Pub/Sub push tới <API public>/billing/iap/google/notifications?token=<GOOGLE_PLAY_RTDN_TOKEN>
# (chuỗi ngẫu nhiên dài, giữ bí mật). KHÔNG commit file service account.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_RTDN_TOKEN=
# Nhận giao dịch thử nghiệm (Apple Sandbox / TestFlight, tài khoản test Google) — mặc định bật vì Apple duyệt app bằng
# sandbox trên server thật; đặt false nếu không muốn bản thử nghiệm được cấp Pro/gems thật.
IAP_ALLOW_SANDBOX=true
