DATABASE_URL=postgresql://laclingo_user:laclingo_password@localhost:5432/trading_db?sslmode=disable
REDIS_URL=redis://localhost:6379
# Bắt buộc khi NODE_ENV=production
# Bắt buộc ngoài `next dev`/test; production tối thiểu 32 ký tự (vd: openssl rand -base64 48)
JWT_SECRET=change-me
BINANCE_BASE_URL=https://data-api.binance.vision

# Số liệu doanh nghiệp (trang /companies) — gói EODHD có Fundamentals API.
# Bỏ trống: dev dùng token demo (vài mã Mỹ), production tắt số liệu (ô hiện "—").
EODHD_API_KEY=
# EODHD_BASE_URL=https://eodhd.com

# Cổ phiếu Việt Nam (trang /vn-stocks) — dữ liệu nạp bằng `npm run vn:sync` / `make vn-sync`, web chỉ đọc DB.
# Danh mục mã + giá ngày: SSI FastConnect Data (miễn phí, đăng ký ConsumerID/Secret tại iboard.ssi.com.vn).
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
# SSI_FC_DATA_URL=https://fc-data.ssi.com.vn/api/v2
# SSI_RPM=30
# Hồ sơ + BCTC: endpoint công khai KHÔNG chính thức của Vietcap — mặc định tắt, chỉ dùng nội bộ/học tập.
# VN_UNOFFICIAL_SOURCES=1
# VIETCAP_IQ_URL=https://iq.vietcap.com.vn/api/iq-insight-service/v1
# VIETCAP_RPM=20

# Thanh toán Pro (trang /pro) — để trống = tắt thanh toán trực tuyến (trang Pro hiện "chưa bật").
#   mock  = cổng GIẢ LẬP để thử toàn bộ luồng trên máy (chỉ chạy khi NODE_ENV là development/test, production luôn tắt)
#   payos / vnpay = cổng thật — cần pháp nhân + hợp đồng merchant, thêm adapter trong src/server/billing/providers/
# PAYMENTS_PROVIDER=mock
# Khoá ký webhook của cổng giả lập (bỏ trống → khoá mặc định chỉ dùng cho dev)
# PAYMENT_MOCK_SECRET=
# URL công khai của app — BẮT BUỘC khi dùng cổng thật (cổng chuyển người dùng về /pro/checkout/result)
# APP_URL=https://trade.example.com

# Ảnh bài học (Cloudflare R2) — thiếu biến nào thì tắt upload
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Số connection tối đa của pool Postgres (mặc định 10)
# DB_POOL_MAX=10

# Số reverse proxy phía trước app (lấy IP thật cho rate limit từ X-Forwarded-For, tính từ phải). Mặc định 1.
# TRUSTED_PROXY_HOPS=1
# Host hợp lệ của app (chống CSRF) — BẮT BUỘC nếu proxy đổi header Host mà không gửi X-Forwarded-Host
# APP_HOSTS=trade.example.com
