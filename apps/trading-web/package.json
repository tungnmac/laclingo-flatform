{
  "name": "trading-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "seed:lessons": "tsx scripts/seed-lessons.ts",
    "seed:companies": "tsx scripts/seed-companies.ts",
    "seed:library": "tsx scripts/seed-library.ts",
    "vn:sync": "tsx scripts/vn-sync.ts",
    "seed:references": "tsx scripts/seed-references.ts",
    "seed:all": "npm run db:seed && npm run seed:lessons && npm run seed:companies && npm run seed:library && npm run seed:references"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "lightweight-charts": "^5.2.1",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
